{
  "name": "dibs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.mjs",
    "dev:api": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "dev:web": "vite --host 0.0.0.0",
    "mcp": "node --import tsx src/mcp/main.ts",
    "mcp:http": "node --import tsx src/mcp/main.ts --http 8790",
    "mcp:start": "node dist/mcp/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ag-grid-community": "^34.3.1",
    "ag-grid-react": "^34.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.10.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^10.0.6",
    "jsdom": "^27.1.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.0"
  },
  "bin": {
    "dibs-mcp": "dist/mcp/main.js"
  }
}
